{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "CAP bookshop backend for Devtoberfest 2026 JSX/TSX runtime session",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "express": "^5"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "bookshop-tsx": "file:../../apps/bookshop-tsx",
    "cds-plugin-ui5": "^0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": ":memory:"
        }
      }
    },
    "protocols": {
      "odata-v4": {
        "path": "/browse"
      }
    }
  }
}
