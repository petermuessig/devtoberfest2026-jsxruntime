  "UI5 V4 action binding (bindContext + execute)": {
    "scope": "typescript",
    "prefix": "ui5-v4-action",
    "description": "OData V4 action binding pattern: bindContext + setParameter + execute",
    "body": [
      "async onSubmitOrder(): Promise<void> {",
      "  const oModel = this.getView().getModel() as ODataModel;",
      "  const bookDetails = this.byId(\"bookDetails\") as VBox;",
      "  const stepInput = this.byId(\"stepInput\") as StepInput;",
      "  const oBinding = bookDetails.getElementBinding();",
      "  const sPath = oBinding.getPath();",
      "  const oContext = oBinding.getBoundContext();",
      "  const bookID = parseInt(sPath.match(/.*\\((\\d+)\\)/)[1]);",
      "  const quantity = stepInput.getValue();",
      "  const title = (oContext.getObject() as { title: string }).title;",
      "  const oOperation = oModel.bindContext(\"/submitOrder(...)\");",
      "  oOperation.setParameter(\"book\", bookID);",
      "  oOperation.setParameter(\"quantity\", quantity);",
      "  try {",
      "    await oOperation.invoke();",
      "    MessageToast.show(`Order successful (${ title }, ${ quantity } pcs.)`);",
      "    oModel.refresh();",
      "    bookDetails.setVisible(false);",
      "  } catch (oError) {",
      "    console.error(\"submitOrder failed\", oError);",
      "  }",
      "}",
    ]
  },

  "UI5 V4 bindElement from event context": {
    "scope": "typescript",
    "prefix": "ui5-bindelement",
    "description": "onSelect pattern: get binding context from event source, bindElement on a container",
    "body": [
      "onSelect(event: Event): void {",
      "  const context = (event.getSource() as unknown as { getBindingContext(): Context }).getBindingContext();",
      "  const ${1:bookDetails} = this.byId(\"${2:bookDetails}\") as ${3:VBox};",
      "  ${1:bookDetails}.bindElement(context.getPath());",
      "  ${1:bookDetails}.setVisible(true);",
      "}"
    ]
  },

  "UI5 TSX SearchField with filter": {
    "scope": "typescript",
    "prefix": "ui5-search-filter",
    "description": "onSearch handler: read query, filter ListBinding by Contains",
    "body": [
      "onSearch(event: Event): void {",
      "  const sQuery = (event.getParameter as (name: string) => string)(\"newValue\");",
      "  const oTable = this.byId(\"booksTable\") as Table;",
      "  const oBinding = oTable.getBinding(\"items\") as ListBinding;",
      "  if (sQuery) {",
      "    oBinding.filter([new Filter(\"${2:title}\", FilterOperator.Contains, sQuery)]);",
      "  } else {",
      "    oBinding.filter([]);",
      "  }",
      "}"
    ]
  },

